<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera is used by the ML Kit scanning activity -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <!-- Uploading backups to Google Drive -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Saving scanned pages as images to the device gallery pre-scoped-storage -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      Google Play services (ML Kit, Drive auth) auto-merges this permission
      even though the app never reads the advertising ID or shows ads.
      Removing it avoids Play Console's advertising ID declaration step.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <application
        android:name=".DocScannerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DocScanner"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DocScanner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".viewer.PdfViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.DocScanner" />

        <activity
            android:name=".editor.PageEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.DocScanner" />

        <activity
            android:name=".cards.CardsActivity"
            android:exported="false"
            android:theme="@style/Theme.DocScanner" />

        <activity
            android:name=".about.AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.DocScanner" />

        <!-- Ask Play services to download the scanner and OCR modules at install time -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="document_ui,ocr" />

        <!-- Share/export scanned files to other apps (Drive, Dropbox, mail, ...) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
